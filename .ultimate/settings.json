{
  "extensions": {
    "enable": ["voice-live"]
  },
  "modelFamilies": {
    "families": {
      "lead": { "model": "ollama/kimi-k2.6:cloud", "thinking": "high", "color": "orange" },
      "review": { "model": "ollama/deepseek-v4-pro:cloud", "thinking": "high" },
      "fast": { "model": "ollama/glm-5.3:cloud" }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      { "command": "pnpm test -- --maxWorkers=2", "timeout": 900 },
      { "command": "pnpm test:e2e", "timeout": 420 }
    ]
  }
}
