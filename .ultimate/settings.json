{
  "extensions": {
    "enable": ["voice-live"]
  },
  "modelFamilies": {
    "families": {
      "lead": { "color": "orange" }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      { "command": "pnpm test -- --maxWorkers=2", "timeout": 900 },
      { "command": "pnpm test:e2e -- --maxWorkers=2", "timeout": 900, "stall": 420 }
    ],
    "push": "fork"
  }
}
